# ==============================================================
# AI Samrat Project Dashboard - Environment Configuration
# ==============================================================

# Core Settings
DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,your-server-domain.com
PORT=8000

# Initial Clean Administrator Account (Auto-created on fresh deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Password123!
ADMIN_EMAIL=admin@aisamrat.com

# Demo Data Seeding (Set to false for clean zero-data production deployment)
SEED_DEMO_DATA=false

# Default initial password for team accounts created via UI
DEFAULT_USER_PASSWORD=AiSamrat@2026!

# ==============================================================
# Database Configuration
# ==============================================================
# Set USE_POSTGRES=true when running with Docker or external PostgreSQL
USE_POSTGRES=true
POSTGRES_DB=project_dashboard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

